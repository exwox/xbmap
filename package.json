{
  "name": "liquidmap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n GATEWAY,WEB -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite --host 0.0.0.0",
    "dev:server": "tsx watch --env-file-if-exists=.env server/index.ts",
    "build": "npm run typecheck && vite build",
    "build:web": "vite build",
    "typecheck": "tsc --noEmit && tsc -p server/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "phase0:fixtures": "node --import tsx scripts/fixtures/generate.ts --check",
    "phase0:bench": "node --expose-gc --import tsx scripts/bench/run.ts --profile baseline --seed 1480744257 --json docs/baselines/phase-0-synthetic-benchmark.json --markdown docs/baselines/phase-0-synthetic-benchmark.md",
    "phase0:bench:quick": "node --expose-gc --import tsx scripts/bench/run.ts --profile quick",
    "phase0:renderer": "node --import tsx scripts/browser/measure-renderer.ts",
    "phase0:verify": "npm run typecheck && npm run phase0:fixtures && npx tsc -p scripts/bench/tsconfig.json --noEmit && npx tsc -p scripts/browser/tsconfig.json --noEmit && npm test && npm run build:web",
    "phase1:test": "vitest run scripts/phase1/phase1.test.ts",
    "phase1:validate": "node --import tsx scripts/phase1/run.ts",
    "phase1:soak:quick": "node --expose-gc --import tsx scripts/phase1/soak.ts --quick",
    "phase1:soak:full": "node --expose-gc --import tsx scripts/phase1/soak.ts --full",
    "phase1:verify": "npm run typecheck && npx tsc -p scripts/phase1/tsconfig.json --noEmit && npm test && npm run phase1:validate && npm run phase1:soak:quick && npm run build:web",
    "phase2:test": "vitest run scripts/phase2",
    "phase2:validate": "node --import tsx scripts/phase2/run.ts",
    "phase2:verify": "npm run typecheck && npx tsc -p scripts/phase2/tsconfig.json --noEmit && npm test && npm run phase2:validate && npm run build:web",
    "phase3:validate": "node --import tsx scripts/phase3/run.ts",
    "phase3:loadtest": "node --import tsx scripts/phase3/load-test.ts --clients 25 --duration 20",
    "phase3:soak24": "node --expose-gc --import tsx scripts/phase1/soak.ts --duration 86400000",
    "phase3:verify": "npm run typecheck && npx tsc -p scripts/phase3/tsconfig.json --noEmit && npm test && npm run phase3:validate && npm run build:web",
    "phase4:test": "vitest run server/__tests__/multiSymbol.test.ts src/lib/useMarketData.test.tsx",
    "phase4:validate": "node --import tsx scripts/phase4/run.ts --symbols 3 --sample-ms 1500 --json docs/baselines/phase-4-validation.json --markdown docs/baselines/phase-4-validation.md",
    "phase4:verify": "npm run typecheck && npx tsc -p scripts/phase4/tsconfig.json --noEmit && npm test && npm run phase4:validate && npm run build:web",
    "phase5:test": "vitest run server/__tests__/marketInsights.test.ts server/__tests__/alertEngine.test.ts server/__tests__/phase5Surface.test.ts server/__tests__/binanceLiquidations.test.ts",
    "phase5:validate": "node --import tsx scripts/phase5/run.ts --json docs/baselines/phase-5-validation.json --markdown docs/baselines/phase-5-validation.md",
    "phase5:verify": "npm run typecheck && npx tsc -p scripts/phase5/tsconfig.json --noEmit && npm test && npm run phase5:validate && npm run build:web",
    "measure:live": "node --import tsx scripts/live/measure-binance.ts",
    "start": "node --env-file-if-exists=.env --import tsx server/index.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@types/pg": "^8.23.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "pg": "^8.23.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "jsdom": "^26.1.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
