# HTTP/WebSocket server
PORT=8787
HOST=0.0.0.0

# 1 = always use the built-in deterministic market simulator.
# 0 = try Binance USD-M Futures, then fall back to demo automatically.
XBMAP_DEMO=0

# Optional comma-separated browser origins allowed to access the gateway.
# Leave empty for local development.
CORS_ORIGIN=http://localhost:5173,http://localhost:8787

# Enables one-hour cache headers for static frontend assets.
NODE_ENV=production

# Optional raw public-market capture. Leave empty to keep recording disabled.
# Use a private, persistent directory and review exchange licensing before
# retaining or redistributing captures.
XBMAP_CAPTURE_DIR=
XBMAP_CAPTURE_QUEUE_RECORDS=8192
XBMAP_CAPTURE_QUEUE_BYTES=16777216
XBMAP_CAPTURE_MAX_BYTES=536870912
XBMAP_CAPTURE_MAX_DURATION_MS=86400000
XBMAP_CAPTURE_RETENTION_MS=86400000

# Durable historical projection. Leave empty to keep the in-memory fallback in
# local development. Docker Compose enables /var/lib/liquidmap/history by
# default and mounts it as a named volume.
XBMAP_HISTORY_DIR=
XBMAP_HISTORY_QUEUE_RECORDS=20000
XBMAP_HISTORY_QUEUE_BYTES=33554432
XBMAP_HISTORY_BATCH_RECORDS=1000
XBMAP_HISTORY_FLUSH_MS=250
XBMAP_HISTORY_SEGMENT_RECORDS=10000
XBMAP_HISTORY_SEGMENT_BYTES=16777216
XBMAP_HISTORY_QUERY_MAX_POINTS=10000
XBMAP_HISTORY_QUERY_MAX_RANGE_MS=86400000
XBMAP_HISTORY_RETENTION_INTERVAL_MS=3600000
XBMAP_HISTORY_RETENTION_TRADE_MS=7776000000
XBMAP_HISTORY_RETENTION_SNAPSHOT_MS=2592000000
XBMAP_HISTORY_RETENTION_DELTA_MS=1209600000
XBMAP_HISTORY_RETENTION_METRIC_1S_MS=31536000000
XBMAP_HISTORY_RETENTION_METRIC_5S_MS=31536000000
XBMAP_HISTORY_RETENTION_METRIC_1M_MS=94608000000
XBMAP_HISTORY_BACKUP_DIR=
XBMAP_HISTORY_BACKUP_INTERVAL_MS=86400000
XBMAP_HISTORY_BACKUP_KEEP=7
XBMAP_REPLAY_SESSION_FILE=
XBMAP_REPLAY_MAX_RANGE_MS=86400000
XBMAP_REPLAY_MAX_PAGE_FRAMES=5000
XBMAP_REPLAY_MAX_VERIFY_RECORDS=250000

# Optional production-storage profile (`docker compose --profile storage up`).
# Replace every default secret before exposing these services outside localhost.
POSTGRES_DB=liquidmap
POSTGRES_USER=liquidmap
POSTGRES_PASSWORD=change-me-before-production
CLICKHOUSE_USER=liquidmap
CLICKHOUSE_PASSWORD=change-me-before-production
MINIO_ROOT_USER=liquidmap
MINIO_ROOT_PASSWORD=change-me-before-production
